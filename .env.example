DATABASE_URL=sqlite:///./storage/postgres/operator_one.db
SESSION_SECRET=dev-session-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ARTIFACTS_DIR=./storage/artifacts/data
# Required on `/internal/intake/*` as header `X-Service-Token`
SERVICE_TOKEN=dev-internal-token
OPENAI_PROXY_API_KEY=dev-openai-proxy-key
# Run queue consumer: `true` (default) = asyncio task inside API process; `false` = run `python -m worker` separately
# WORKER_IN_PROCESS=true
# LLM for chat, summarize_text, and Open WebUI proxy: heuristic (default) or openai_compatible (Ollama/LM Studio)
# LLM_BACKEND=openai_compatible
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=llama3.2
# LOCAL_LLM_API_KEY=
# Optional: faster worker wake-up (see docs/DEPLOYMENT.md)
# REDIS_URL=redis://localhost:6379/0
# OPENWEBUI_SYNTHETIC_RUNS=false
# OPENWEBUI_RUN_USER_ID=openwebui-proxy
